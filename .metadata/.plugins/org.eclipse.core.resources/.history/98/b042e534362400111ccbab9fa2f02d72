package p01;

import java.util.Scanner;

public class Matrix {

	public static void main(String[] args) {
		Scanner input = new Scanner(System.in);
		int matrixA[][] = new int[3][3];
		int matrixB[][]= new int[3][3];
		int matrixC[][]= new int[3][3];
		
		System.out.println("Matrix A eigeben");
		for (int i = 0; i<3; i++) {
			for(int j=0; j<3; j++) {
				matrixA[i][j] = input.nextInt();
			}
		}
		
		
		System.out.println("Matrix B eigeben");
		for (int i = 0; i<3; i++) {
			for(int j=0; j<3; j++) {
				matrixB[i][j] = input.nextInt();
			}
		}
		
		for (int i = 0; i<3; i++) {
			for(int j=0; j<3; j++) {
				matrixC[i][j] = matrixA[i][j] + matrixB[i][j];
			}
		}
		
		System.out.println(matrixA[0][0]+" "+ matrixA[0][0]+" "+ matrixA[0][2]+"     " +matrixB[0][0]+" "+ matrixB[0][0]+" "+ matrixB[0][2]+"     " +matrixC[0][0]+" "+ matrixC[0][0]+" "+ matrixC[0][2]);
		System.out.println(matrixA[1][1]+" "+ matrixA[1][1]+" "+ matrixA[1][2]+"  +  " +matrixB[1][1]+" "+ matrixB[1][1]+" "+ matrixB[1][2]+"  =  " +matrixC[1][1]+" "+ matrixC[1][1]+" "+ matrixC[1][2]);
		System.out.println(matrixA[2][2]+" "+ matrixA[2][2]+" "+ matrixA[2][2]+"     " +matrixB[2][2]+" "+ matrixB[2][2]+" "+ matrixB[2][2]+"     " +matrixC[2][2]+" "+ matrixC[2][2]+" "+ matrixC[2][2]);
		
		
		
		input.close();
	}

}
